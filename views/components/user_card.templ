package views

import "htmxgo/models"

templ UserCard(user *models.UserModel) {
	<div class="flex flex-col justify-center items-center py-6 bg-gray-800 rounded-b-2xl text-white shadow-lg">
		<div class="text-white flex justify-between pb-6 px-6 self-stretch">
			<div></div>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-9 h-9">
				<path fill-rule="evenodd" d="M5.25 9a6.75 6.75 0 0 1 13.5 0v.75c0 2.123.8 4.057 2.118 5.52a.75.75 0 0 1-.297 1.206c-1.544.57-3.16.99-4.831 1.243a3.75 3.75 0 1 1-7.48 0 24.585 24.585 0 0 1-4.831-1.244.75.75 0 0 1-.298-1.205A8.217 8.217 0 0 0 5.25 9.75V9Zm4.502 8.9a2.25 2.25 0 1 0 4.496 0 25.057 25.057 0 0 1-4.496 0Z" clip-rule="evenodd"></path>
			</svg>
		</div>
		<img class="ring-2 ring-white/[0.14] ring-offset-1 rounded-full border border-white/[0.14] shadow-sm w-[130px] h-[130px]" src={ user.MetaData.Picture } alt="user image"/>
		<h1 class="text-center text-2xl mt-4 tracking-wider mb-2">{ user.MetaData.FullName }</h1>
		<div class="flex self-stretch mt-4 justify-around px-6 font-bold">
			<button
				_="on click remove .active from <button.nav-button.active/> then add .active to me"
				class="nav-button"
			>
				<span>QP</span><span class="ml-1 text-white/[0.67]">1329</span>
			</button>
			<button
				_="on click remove .active from <button.nav-button.active/> then add .active to me"
				hx-trigger="click, load"
				hx-get="/partials/tabs/games"
				hx-swap="innerHTML transition:true"
				hx-target="#tabView"
				hx-indicator="#listTxtLoader"
				class="nav-button active"
			>
				<span>Games</span>
			</button>
			<button
				_="on click remove .active from <button.nav-button.active/> then add .active to me"
				class="nav-button"
			>
				<span>Rank</span><span class="ml-1 text-white/[0.67]">9</span>
			</button>
		</div>
	</div>
}
