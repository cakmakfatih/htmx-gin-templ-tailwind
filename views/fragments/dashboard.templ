package views

import (
	"htmxgo/models"
	components "htmxgo/views/components"
)

templ Dashboard(user *models.UserModel) {
	<div class="flex flex-col flex-1">
		@components.UserCard(user)
		<div>
			<div class="flex justify-center m-4 py-3 px-4 rounded-full bg-white text-gray-600 font-bold">
				<h1 class="text-xl">Arena Quiz in 14:33</h1>
			</div>
		</div>
		<div class="flex flex-col flex-1">
			@components.ListTxtLoader()
		</div>
	</div>
}
